{
  "name": "@promptbranch/mcp",
  "version": "0.2.3",
  "mcpName": "io.github.PromptBranch/promptbranch",
  "license": "MIT",
  "type": "module",
  "description": "Local-first MCP server for versioning, searching, evaluating, and improving AI prompts with coding agents.",
  "keywords": [
    "promptbranch",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "prompt-library",
    "prompt-management",
    "prompt-engineering",
    "prompt-versioning",
    "prompt-evaluation",
    "local-first",
    "ai-agents",
    "coding-agents"
  ],
  "homepage": "https://promptbranch.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PromptBranch/promptbranch.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/PromptBranch/promptbranch/issues"
  },
  "bin": {
    "promptbranch-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-output.mjs && tsc -p tsconfig.json --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.js --external:better-sqlite3 --banner:js=\"#!/usr/bin/env node\"",
    "prepack": "pnpm build",
    "test": "pnpm build && vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@promptbranch/core": "workspace:*",
    "better-sqlite3": "13.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.3.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
